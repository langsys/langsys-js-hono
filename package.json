{
    "name": "langsys-js-hono",
    "version": "0.1.0",
    "description": "Hono middleware for the Langsys translation SDK — realtime continuous translations with automatic token discovery, multi-locale safe, on Node, Bun, Deno, and edge runtimes.",
    "author": "Langsys",
    "license": "MIT",
    "homepage": "https://github.com/langsys/langsys-js-hono",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/langsys/langsys-js-hono.git"
    },
    "bugs": {
        "url": "https://github.com/langsys/langsys-js-hono/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "i18n",
        "l10n",
        "hono",
        "middleware",
        "edge",
        "cloudflare-workers",
        "bun",
        "deno",
        "server",
        "language",
        "localization",
        "internationalization",
        "translation",
        "langsys",
        "sdk"
    ],
    "peerDependencies": {
        "hono": "^4.0.0"
    },
    "dependencies": {
        "langsys-js-typescript": "^0.6.5"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "hono": "^4.6.0",
        "prettier": "^3.3.0",
        "tsup": "^8.4.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.0"
    }
}
